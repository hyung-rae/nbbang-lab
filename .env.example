# .env.local 로 복사해 채운다. 실제 값은 커밋하지 않는다 (.gitignore: .env.*)
# Vercel 에는 Project Settings → Environment Variables 에 같은 이름으로 등록한다.

# 배포 주소 (OG 이미지·sitemap 절대 주소). 비우면 Vercel 프로덕션 주소 → localhost 순
NEXT_PUBLIC_SITE_URL=

# Supabase — Project Settings → API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
# 서버 전용. secret key(sb_secret_…) 또는 레거시 service_role key. NEXT_PUBLIC_ 을 붙이지 않는다
SUPABASE_SECRET_KEY=

# 브라우저용 (4단계 Realtime 신호 수신에만 사용 — 테이블 접근 권한 없음)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 네이버 클라우드 플랫폼 Maps — Geocoding (숙소 주소 → 좌표, 날씨용). 서버 전용
# console.ncloud.com → Services → Application Services → Maps → Application 등록(Geocoding 체크) → 인증 정보
# Client ID → _KEY_ID, Client Secret → _KEY. 비우면 좌표를 채우지 않는다(날씨 줄만 숨음)
NAVER_MAPS_API_KEY_ID=
NAVER_MAPS_API_KEY=

# YouTube Data API v3 (여행 플레이리스트) — Google Cloud 콘솔 → API 키. 서버 전용
YOUTUBE_API_KEY=
