# .env.local 로 복사해 채운다. 실제 값은 커밋하지 않는다 (.gitignore: .env.*)
# Vercel 에는 Project Settings → Environment Variables 에 같은 이름으로 등록한다.

# 배포 주소 (OG 이미지·sitemap 절대 주소). 비우면 Vercel 프로덕션 주소 → localhost 순
NEXT_PUBLIC_SITE_URL=

# Supabase — Project Settings → API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
# 서버 전용. secret key(sb_secret_…) 또는 레거시 service_role key. NEXT_PUBLIC_ 을 붙이지 않는다
SUPABASE_SECRET_KEY=

# 브라우저용 (Realtime 신호 수신에만 사용 — 테이블 접근 권한 없음). Vercel 에는 Config 타입으로 등록
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 네이버 클라우드 플랫폼 Maps — Geocoding (숙소 주소 → 좌표, 날씨용). 서버 전용
# console.ncloud.com → Services → Application Services → Maps → Application 등록(Geocoding 만 체크) → 인증 정보
# 결제 수단 등록 필요. 서비스 환경(Web 서비스 URL·Android·iOS)은 비워도 된다 — 서버에서만 부른다(실측)
# Client ID → _KEY_ID, Client Secret → _KEY. 비우면 좌표를 채우지 않는다(날씨 줄만 숨음)
NAVER_MAPS_API_KEY_ID=
NAVER_MAPS_API_KEY=

# YouTube Data API v3 (음악 탭) — 서버 전용, 결제 수단 불필요
# Google Cloud 콘솔 → 프로젝트 → API 및 서비스 → 라이브러리 → YouTube Data API v3 사용 → 사용자 인증 정보 → API 키
# 키 제한: 애플리케이션 제한 "없음"(서버 호출·Vercel IP 고정 아님), API 제한 "YouTube Data API v3 만". 만든 직후 몇 분은 key not valid 가 날 수 있다
YOUTUBE_API_KEY=

# 관리자 로그인 (관리자 한 명 — 설정·새 여행·여행 삭제). 서버 전용, NEXT_PUBLIC_ 을 붙이지 않는다
# 비밀번호는 길게(대입 시도 제한이 서버 메모리라 완전하지 않다). 비우면 관리자 기능이 잠긴다
ADMIN_PASSWORD=
# 쿠키 서명 키(관리자 세션 + 여행 입장 표) — 32자 이상 무작위. 만들기: openssl rand -base64 48
# 바꾸면 모든 기기에서 관리자 로그아웃 + 여행 입장 비밀번호를 다시 입력해야 한다. 없으면 비밀번호 있는 여행은 관리자만 들어간다
ADMIN_SESSION_SECRET=
